{
  "schemaVersion": "1.0",
  "templateSlug": "cv-jasper-reports",
  "evaluationBlocks": [
    {
      "blockId": "auto",
      "evaluationType": "automated_pipeline",
      "metrics": [
        {
          "metricKey": "jrxml_count",
          "worker": "MetricsWorker",
          "weight": 15,
          "threshold": 3,
          "config": {
            "targetDir": "src/main/resources/reports",
            "fileExtension": ".jrxml",
            "minCount": 3
          }
        },
        {
          "metricKey": "exception_handling",
          "worker": "MetricsWorker",
          "weight": 20,
          "threshold": 0.70,
          "config": {
            "targetFiles": ["src/main/java/**/*.java"],
            "minRealCatchRatio": 0.70
          }
        },
        {
          "metricKey": "test_pass_rate",
          "worker": "TestWorker",
          "weight": 30,
          "threshold": 1.0,
          "config": {
            "testCommand": "mvn test",
            "testRunner": "junit5",
            "requiresDb": true
          }
        },
        {
          "metricKey": "cyclomatic_complexity",
          "worker": "MetricsWorker",
          "weight": 20,
          "threshold": 10,
          "config": {
            "tool": "pmd",
            "maxAllowed": 10,
            "targetFiles": ["src/main/java/**/*.java"]
          }
        },
        {
          "metricKey": "lint_violations",
          "worker": "LintWorker",
          "weight": 15,
          "threshold": 0.0,
          "config": {
            "lintCommand": "mvn checkstyle:check",
            "linter": "checkstyle"
          }
        }
      ]
    }
  ]
}
